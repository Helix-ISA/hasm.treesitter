{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hxs",
      "camelcase": "hxs",
      "title": "hxs",
      "scope": "source.hxs",
      "file-types": [
        "hxs"
      ],
      "injection-regex": "^hxs$",
      "class-name": "TreeSitterHxs"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "hxs parser",
    "authors": [
      {
        "name": "Helix-ISA",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/Helix-ISA/hasm-parser/",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
