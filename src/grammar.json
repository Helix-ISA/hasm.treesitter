{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "hasm",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "statement"
          },
          {
            "type": "SYMBOL",
            "name": "blank_line"
          }
        ]
      }
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "label"
            },
            {
              "type": "SYMBOL",
              "name": "instruction"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "blank_line": {
      "type": "STRING",
      "value": "\n"
    },
    "label": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "two_operand_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "one_operand_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "zero_operand_instruction"
        }
      ]
    },
    "two_operand_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opcode",
          "content": {
            "type": "SYMBOL",
            "name": "two_operand_opcode"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "."
                },
                {
                  "type": "FIELD",
                  "name": "width",
                  "content": {
                    "type": "SYMBOL",
                    "name": "width"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "operand1",
          "content": {
            "type": "SYMBOL",
            "name": "operand"
          }
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "FIELD",
          "name": "operand2",
          "content": {
            "type": "SYMBOL",
            "name": "operand"
          }
        }
      ]
    },
    "one_operand_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opcode",
          "content": {
            "type": "SYMBOL",
            "name": "one_operand_opcode"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "."
                },
                {
                  "type": "FIELD",
                  "name": "width",
                  "content": {
                    "type": "SYMBOL",
                    "name": "width"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "operand1",
          "content": {
            "type": "SYMBOL",
            "name": "operand"
          }
        }
      ]
    },
    "zero_operand_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opcode",
          "content": {
            "type": "STRING",
            "value": "ret"
          }
        }
      ]
    },
    "two_operand_opcode": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "mov"
          },
          {
            "type": "STRING",
            "value": "ld"
          },
          {
            "type": "STRING",
            "value": "st"
          },
          {
            "type": "STRING",
            "value": "add"
          },
          {
            "type": "STRING",
            "value": "sub"
          },
          {
            "type": "STRING",
            "value": "and"
          },
          {
            "type": "STRING",
            "value": "or"
          },
          {
            "type": "STRING",
            "value": "xor"
          }
        ]
      }
    },
    "one_operand_opcode": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "not"
          },
          {
            "type": "STRING",
            "value": "beq"
          },
          {
            "type": "STRING",
            "value": "bne"
          },
          {
            "type": "STRING",
            "value": "jmp"
          },
          {
            "type": "STRING",
            "value": "call"
          }
        ]
      }
    },
    "width": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "b"
        },
        {
          "type": "STRING",
          "value": "w"
        },
        {
          "type": "STRING",
          "value": "d"
        },
        {
          "type": "STRING",
          "value": "q"
        }
      ]
    },
    "operand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "register"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "memory"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "register": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "r([0-9]|[12][0-9]|3[01])"
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[0-9]+"
          },
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F]+"
          },
          {
            "type": "PATTERN",
            "value": "0[bB][01]+"
          }
        ]
      }
    },
    "memory": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "base",
          "content": {
            "type": "SYMBOL",
            "name": "register"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "operator",
                  "content": {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "STRING",
                        "value": "+"
                      },
                      {
                        "type": "STRING",
                        "value": "-"
                      }
                    ]
                  }
                },
                {
                  "type": "FIELD",
                  "name": "offset",
                  "content": {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "register"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "number"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}